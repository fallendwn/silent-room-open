PORT=8080

POSTGRES_USER=confession
POSTGRES_PASSWORD=change-me
POSTGRES_DB=confession
POSTGRES_PORT=5432
DATABASE_URL=postgres://confession:change-me@localhost:5432/confession?sslmode=disable
DATABASE_URL_DOCKER=postgres://confession:change-me@postgres:5432/confession?sslmode=disable

IP_HASH_SALT=replace-with-a-long-random-value
TRUST_PROXY=false

RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_BURST=30

SUBMIT_MIN_INTERVAL=10m
SUBMIT_DAILY_LIMIT=5
